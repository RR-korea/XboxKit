<Window x:Class="XboxKit.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XboxKit - Xbox / Xbox 360 ISO 변환 및 복원 도구" 
        Height="780" Width="920"
        MinHeight="600" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Input File -->
            <RowDefinition Height="Auto"/> <!-- Mode & Options -->
            <RowDefinition Height="Auto"/> <!-- Action Buttons & Progress -->
            <RowDefinition Height="*"/>    <!-- Log Viewer -->
        </Grid.RowDefinitions>

        <!-- 1. 파일 선택 및 드래그 앤 드롭 영역 -->
        <GroupBox Grid.Row="0" Header="입력 파일 (Redump ISO / XISO / Video ISO)" Margin="0,0,0,12" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtInputPath" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                         ToolTip="변환하거나 복원할 ISO 또는 XISO 파일 경로를 입력하거나 파일을 드래그하여 놓으세요."
                         TextChanged="TxtInputPath_TextChanged"/>
                <Button x:Name="BtnBrowseFile" Grid.Row="0" Grid.Column="1" Content="파일 찾기..." 
                        Click="BtnBrowseFile_Click" Background="#495057" Width="100"/>
                <Button x:Name="BtnClearFile" Grid.Row="0" Grid.Column="2" Content="초기화" 
                        Click="BtnClearFile_Click" Background="#6C757D" Width="70"/>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="4,8,4,0" 
                        Background="#E9ECEF" CornerRadius="4" Padding="10,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="💡 팁: " FontWeight="Bold" Foreground="#495057"/>
                        <TextBlock x:Name="TxtFileDetection" 
                                   Text="ISO 또는 XISO 파일을 창 위에 드래그 앤 드롭하거나 [파일 찾기]를 클릭하세요." 
                                   Foreground="#495057"/>
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>

        <!-- 2. 모드 및 세부 옵션 -->
        <TabControl x:Name="TabMainMode" Grid.Row="1" Margin="0,0,0,12" SelectionChanged="TabMainMode_SelectionChanged">
            <!-- 탭 1: 추출 및 변환 모드 -->
            <TabItem Header="  추출 및 변환 (Extract &amp; Convert)  " FontWeight="SemiBold">
                <StackPanel Margin="12">
                    <!-- 프리셋 선택 -->
                    <GroupBox Header="변환 프리셋 (원클릭 설정)" Margin="0,0,0,8">
                        <StackPanel Margin="6">
                            <RadioButton x:Name="RbPresetBest" Content="🎮 에뮬레이터 최적화 XISO (-b) [추천]" 
                                         IsChecked="True" Checked="RbPreset_Checked"
                                         ToolTip="트림 및 필러 데이터를 제거(Wipe)하여 용량을 최소화한 깨끗한 XISO를 만듭니다 (에뮬레이터 구동용)."/>
                            <TextBlock Margin="24,0,0,6" Text="불필요한 무작위 패딩을 0으로 채우고 끝을 잘라내어 용량을 최소화하고 압축 효율을 극대화합니다." 
                                       Foreground="#6C757D" FontSize="11"/>

                            <RadioButton x:Name="RbPresetAll" Content="📦 무손실 전체 보존 백업 (-a)" 
                                         Checked="RbPreset_Checked"
                                         ToolTip="XISO, 비디오 ISO, 필러 데이터, 난수 시드, 시스템 업데이트 등 모든 원본 데이터를 추출합니다."/>
                            <TextBlock Margin="24,0,0,6" Text="추후 원본 Redump ISO로 완벽히 100% 동일하게 복원(Rebuild)할 수 있도록 모든 요소를 분할 추출합니다." 
                                       Foreground="#6C757D" FontSize="11"/>

                            <RadioButton x:Name="RbPresetCompress" Content="🗜️ ZArchive 무손실 압축 (-c)" 
                                         Checked="RbPreset_Checked"
                                         ToolTip="게임 파일들을 ZArchive(.zar)로 고압축하고 스켈레톤 XISO 및 비디오 파티션을 추출합니다."/>
                            <TextBlock Margin="24,0,0,6" Text="ZArchive 지원 에뮬레이터용으로 고압축 .zar 파일과 복원용 스켈레톤을 생성합니다." 
                                       Foreground="#6C757D" FontSize="11"/>

                            <RadioButton x:Name="RbPresetCustom" Content="⚙️ 사용자 정의 세부 옵션 (Custom)" 
                                         Checked="RbPreset_Checked"
                                         ToolTip="원하는 추출 및 처리 옵션을 직접 체크하여 선택합니다."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 세부 옵션 체크박스 영역 (Custom 선택 시 활성화) -->
                    <GroupBox x:Name="GrpCustomOptions" Header="세부 옵션 선택" IsEnabled="False">
                        <UniformGrid Columns="2" Margin="6">
                            <CheckBox x:Name="ChkExtractXiso" Content="XISO 게임 파티션 추출 (-x)" ToolTip="XDVDFS 게임 파티션 .xiso 파일 생성"/>
                            <CheckBox x:Name="ChkTrim" Content="XISO 끝부분 자르기 / 트림 (-t)" ToolTip="게임 파티션 뒤쪽의 빈 공간을 잘라냅니다."/>
                            <CheckBox x:Name="ChkWipe" Content="XISO 무작위 필러 0으로 지우기 (-w)" ToolTip="무작위 패딩 데이터를 0으로 덮어써 압축률을 높입니다."/>
                            <CheckBox x:Name="ChkExtractVideo" Content="비디오 파티션 추출 (-v)" ToolTip="DVD-Video 파티션을 .video.iso 로 추출"/>
                            <CheckBox x:Name="ChkExtractFiller" Content="무작위 필러 데이터 별도 저장 (-r)" ToolTip="복원용 .filler 파일 추출"/>
                            <CheckBox x:Name="ChkExtractSeed" Content="XGD1 난수 시드 추출 (-s)" ToolTip="초기 XGD1 디스크용 .seed 추출"/>
                            <CheckBox x:Name="ChkExtractUpdate" Content="시스템 업데이트 추출 (-u, XGD3)" ToolTip="비디오 파티션에서 su20076000 시스템 업데이트 분리"/>
                            <CheckBox x:Name="ChkExtractOutput" Content="게임 파일들을 폴더로 직접 추출 (-o)" ToolTip="XISO 내부의 게임 파일들을 디렉터리에 추출"/>
                            <CheckBox x:Name="ChkExtractSkeleton" Content="스켈레톤 XISO 추출 (-p)" ToolTip="게임 파일 내용이 0으로 채워진 스켈레톤 추출"/>
                            <CheckBox x:Name="ChkExtractZar" Content="ZArchive(.zar) 생성 (-z)" ToolTip="게임 파일들을 ZArchive 형식으로 압축 생성"/>
                        </UniformGrid>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- 탭 2: 복원 및 재구축 모드 -->
            <TabItem Header="  원본 복원 (Rebuild Redump ISO)  " FontWeight="SemiBold">
                <StackPanel Margin="12">
                    <TextBlock Text="분할 또는 트림된 XISO를 관련 보조 파일들과 결합하여 100% 동일한 원본 Redump ISO로 재구축합니다." 
                               FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="※ 입력 파일로 .xiso 를 지정하면 같은 폴더의 보조 파일들(.video.iso, .filler, .seed 등)을 자동으로 찾아 결합합니다." 
                               Foreground="#6C757D" Margin="0,0,0,12"/>

                    <GroupBox Header="추가 결합 파일 (옵션 / 필요시 추가)">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="BtnAddRebuildFile" Content="보조 파일 추가..." Click="BtnAddRebuildFile_Click" Background="#495057"/>
                                <Button x:Name="BtnRemoveRebuildFile" Content="선택 항목 제거" Click="BtnRemoveRebuildFile_Click" Background="#6C757D"/>
                                <Button x:Name="BtnClearRebuildFiles" Content="목록 비우기" Click="BtnClearRebuildFiles_Click" Background="#6C757D"/>
                            </StackPanel>
                            <ListBox x:Name="ListRebuildFiles" Grid.Row="1" Height="100" Margin="0,4,0,0" SelectionMode="Extended"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- 3. 실행 및 진행 상태 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="TxtStatus" Text="상태: 대기 중" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ProgressBar x:Name="PbProgress" Height="18" IsIndeterminate="False" Value="0" Maximum="100"/>
            </StackPanel>

            <Button x:Name="BtnTestInspect" Grid.Column="1" Content="🔍 분석 / 사전 테스트" Width="150" Height="42" 
                    FontSize="13" Background="#0D6EFD" Click="BtnTestInspect_Click" ToolTip="파일을 수정하지 않고 디스크 이미지 헤더 및 복원/추출 가능 여부를 안전하게 검사합니다."/>
            <Button x:Name="BtnStart" Grid.Column="2" Content="▶ 작업 시작" Width="130" Height="42" 
                    FontSize="13" Background="#198754" Click="BtnStart_Click"/>
            <Button x:Name="BtnCancel" Grid.Column="3" Content="■ 취소" Width="80" Height="42" 
                    FontSize="13" Background="#DC3545" IsEnabled="False" Click="BtnCancel_Click"/>
        </Grid>

        <!-- 4. 실시간 로그 창 -->
        <GroupBox Grid.Row="3" Header="실시간 작업 로그">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="TxtLog" Grid.Row="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Auto" Background="#1E1E1E" Foreground="#D4D4D4" 
                         FontFamily="Consolas, Courier New, monospace" FontSize="12" Margin="0,0,0,6"
                         TextWrapping="Wrap"/>

                <Grid Grid.Row="1">
                    <TextBlock x:Name="TxtLogFilePath" VerticalAlignment="Center" Foreground="#6C757D" FontSize="11"
                               Text="로그 파일: 준비 중..."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📂 로그 폴더 열기" Click="BtnOpenLogDir_Click" Background="#495057" Padding="10,4"/>
                        <Button Content="로그 복사" Click="BtnCopyLog_Click" Background="#495057" Padding="10,4"/>
                        <Button Content="로그 지우기" Click="BtnClearLog_Click" Background="#6C757D" Padding="10,4"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
